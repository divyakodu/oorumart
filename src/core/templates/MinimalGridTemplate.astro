---
import ProductCard from '../components/ProductCard.astro';

export interface Props {
  shop: any;
  products: any[];
  categories: any[];
  primaryColor?: string;
}

const { shop, products = [], categories = [] } = Astro.props;
---

<main class="flex-1 max-w-7xl mx-auto px-4 sm:px-6 py-8 space-y-8 bg-slate-50">
  <div class="bg-slate-900 text-white p-8 rounded-xl shadow-md space-y-3">
    <span class="text-xs uppercase font-extrabold tracking-widest text-slate-400">Express Catalog</span>
    <h1 class="text-3xl font-extrabold uppercase tracking-wide">{shop.name}</h1>
    <p class="text-xs text-slate-300">Clean, fast, minimal shopping experience.</p>
  </div>

  <div class="grid grid-cols-2 sm:grid-cols-3 md:grid-cols-4 gap-4">
    {products.map((p: any) => (
      <ProductCard product={p} shopSlug={shop.slug} />
    ))}
  </div>
</main>

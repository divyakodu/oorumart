  <script define:vars={{ allShopsData: allShops, supabaseUrl, supabaseAnonKey }}>
    let currentShop = null;
    let realtimeChannel = null;

    console.log('🚀 Merchant Admin Portal Script Initialized. Registered shops:', allShopsData.length);

    window.showToast = function(title, message, icon = '✅') {
      const modal = document.getElementById('toast-modal');
      const card = document.getElementById('toast-card');
      const iconElem = document.getElementById('toast-icon');
      const titleElem = document.getElementById('toast-title');
      const msgElem = document.getElementById('toast-message');

      if (iconElem) iconElem.innerText = icon;
      if (titleElem) titleElem.innerText = title;
      if (msgElem) msgElem.innerText = message;

      if (modal) {
        modal.classList.remove('hidden');
        modal.classList.remove('opacity-0', 'pointer-events-none');
      }
      if (card) { card.classList.remove('scale-95'); card.classList.add('scale-100'); }
    };

    window.closeToastModal = function() {
      const modal = document.getElementById('toast-modal');
      const card = document.getElementById('toast-card');
      if (modal) {
        modal.classList.add('opacity-0', 'pointer-events-none', 'hidden');
      }
      if (card) { card.classList.remove('scale-100'); card.classList.add('scale-95'); }
    };

    let pendingConfirmResolver = null;

    window.showThemeConfirm = function(title, message, confirmText = 'Delete', icon = '🗑️') {
      return new Promise((resolve) => {
        pendingConfirmResolver = resolve;
        const modal = document.getElementById('confirm-modal');
        const card = document.getElementById('confirm-card');
        const iconElem = document.getElementById('confirm-icon');
        const titleElem = document.getElementById('confirm-title');
        const msgElem = document.getElementById('confirm-message');
        const actionBtn = document.getElementById('confirm-action-btn');

        if (iconElem) iconElem.innerText = icon;
        if (titleElem) titleElem.innerText = title;
        if (msgElem) msgElem.innerText = message;
        if (actionBtn) {
          actionBtn.innerText = confirmText;
          actionBtn.onclick = function() {
            closeConfirmModal(true);
          };
        }

        if (modal) { modal.classList.remove('hidden', 'opacity-0', 'pointer-events-none'); }
        if (card) { card.classList.remove('scale-95'); card.classList.add('scale-100'); }
      });
    };

    window.closeConfirmModal = function(result) {
      const modal = document.getElementById('confirm-modal');
      const card = document.getElementById('confirm-card');
      if (modal) {
        modal.classList.add('opacity-0', 'pointer-events-none');
        setTimeout(() => modal.classList.add('hidden'), 300);
      }
      if (card) { card.classList.remove('scale-100'); card.classList.add('scale-95'); }
      if (pendingConfirmResolver) {
        pendingConfirmResolver(result);
        pendingConfirmResolver = null;
      }
    };

    window.handleVendorLogin = function(e) {
      if (e) e.preventDefault();
      const selectedSlug = document.getElementById('login-shop-select').value;
      const pin = document.getElementById('login-pin-input').value;

      console.log('🔐 Merchant Login Attempt:', { selectedSlug, pin });

      if (pin !== "1234") {
        window.showToast('Authentication Error', 'Invalid Security PIN! Default PIN is 1234.', '⚠️');
        return;
      }

      currentShop = allShopsData.find(s => s.slug === selectedSlug) || allShopsData[0];

      try {
        localStorage.setItem('oorumart_admin_session_slug', currentShop.slug);
      } catch (err) {}

      // Update Header & Controls
      const titleElem = document.getElementById('active-vendor-title');
      const avatarElem = document.getElementById('active-vendor-avatar');
      const domainElem = document.getElementById('active-vendor-domain');
      const liveLinkElem = document.getElementById('live-shop-link');
      
      const nameInput = document.getElementById('settings-name');
      const phoneInput = document.getElementById('settings-phone');
      const annInput = document.getElementById('settings-announcement');
      const taglineInput = document.getElementById('settings-tagline');
      const tmplInput = document.getElementById('settings-template');
      const colorInput = document.getElementById('settings-primary-color');
      const hexInput = document.getElementById('settings-primary-hex');
      const secColorInput = document.getElementById('settings-secondary-color');
      const secHexInput = document.getElementById('settings-secondary-hex');
      const fontInput = document.getElementById('settings-font-title');

      if (titleElem) titleElem.innerText = currentShop.name;
      if (avatarElem) avatarElem.innerText = currentShop.slug.slice(0, 2).toUpperCase();
      if (domainElem) domainElem.innerText = `${currentShop.slug}.oorumart.in`;
      if (liveLinkElem) liveLinkElem.href = `/?shop=${currentShop.slug}`;
      if (nameInput) nameInput.value = currentShop.name || '';
      if (phoneInput) phoneInput.value = currentShop.phone || '918197921458';
      if (annInput) annInput.value = currentShop.announcement_text || '';
      if (taglineInput) taglineInput.value = currentShop.tagline || '';
      if (tmplInput) tmplInput.value = currentShop.template || 'gift_novelty_template_1';
      
      const pColor = currentShop.theme?.primary_color || '#00A896';
      if (colorInput) colorInput.value = pColor;
      if (hexInput) hexInput.value = pColor;

      const sColor = currentShop.theme?.secondary_color || '#F8FAFC';
      if (secColorInput) secColorInput.value = sColor;
      if (secHexInput) secHexInput.value = sColor;

      if (fontInput) fontInput.value = currentShop.theme?.font_title || 'Playfair Display';

      // Populate Category Dropdown
      const catSelect = document.getElementById('new-prod-category');
      if (catSelect) {
        catSelect.innerHTML = (currentShop.categories || []).map(c => `
          <option value="${c.id}">${c.label}</option>
        `).join('');
      }

      // Hide login modal explicitly
      const modal = document.getElementById('admin-login-screen');
      if (modal) {
        modal.classList.add('hidden');
        modal.style.display = 'none';
      }

      console.log('✅ Logged in successfully as merchant:', currentShop.name);

      // Request OS notification permission immediately on login (requires user gesture — login click qualifies)
      window.requestNotifPermission().then(granted => {
        if (granted) console.log('🔔 OS notification permission granted — order alerts will use device sound');
        else console.warn('⚠️ Notification permission denied — falling back to synthesized chime');
      });

      window.renderAdminProducts();
      window.renderAdminCategories();
      window.renderAdminHeroBanners();
      window.updateLivePreview();
      window.loadAdminOrders();

      // Start hybrid sync polling interval (4s) as guaranteed fallback in case WebSocket drops
      if (ordersPollInterval) clearInterval(ordersPollInterval);
      ordersPollInterval = setInterval(() => {
        if (currentShop) window.loadAdminOrders(true);
      }, 4000);

      // Industry Standard: Event-Driven Realtime WebSocket Push
      if (window.supabase && supabaseUrl && supabaseAnonKey) {
        try {
          const supabaseClient = window.supabase.createClient(supabaseUrl, supabaseAnonKey);
          if (realtimeChannel) {
            try { supabaseClient.removeChannel(realtimeChannel); } catch (e) {}
          }
          realtimeChannel = supabaseClient
            .channel(`public-orders-${currentShop.slug}`)
            .on('postgres_changes', {
              event: '*',
              schema: 'public',
              table: 'orders'
            }, (payload) => {
              if (currentShop && payload.new && (payload.new.shop_slug === currentShop.slug || !payload.new.shop_slug)) {
                console.log('🔔 Realtime Order Received via Supabase Socket for tenant:', currentShop.slug, payload.new);
                window.playOrderNotificationSound(
                  `🛍️ New Order — ${currentShop.name}`,
                  `Order #${payload.new.order_id} | Rs. ${payload.new.total} | ${payload.new.customer_name}`
                );
                window.loadAdminOrders();
              }
            })
            .subscribe((status) => {
              console.log(`📡 Supabase Realtime Socket Status for [${currentShop.slug}]:`, status);
            });
        } catch (err) {}
      }
    };


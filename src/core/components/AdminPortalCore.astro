---
export const prerender = false;

import '../styles/global.css';
import { getAllShopsConfigAsync } from '../lib/getShopConfig';

export interface Props {
  shopSlug?: string;
}

const { shopSlug } = Astro.props;
const allShops = await getAllShopsConfigAsync();
const supabaseUrl = process.env.PUBLIC_SUPABASE_URL || '';
const supabaseAnonKey = process.env.PUBLIC_SUPABASE_ANON_KEY || '';
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Vendor Admin Portal | Oorumart Merchant Center</title>
  
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Montserrat:wght@400;500;600;700;800&family=Playfair+Display:ital,wght@0,600;0,700;1,400&family=Cinzel:wght@600;700&display=swap" rel="stylesheet">
  <script src="https://cdn.jsdelivr.net/npm/@supabase/supabase-js@2"></script>
  
  <style>
    * { box-sizing: border-box; }
    body {
      font-family: 'Montserrat', sans-serif;
      margin: 0;
      padding: 0;
      background-color: #F8FAFC;
      color: #0F172A;
    }
    .font-serif-title {
      font-family: 'Playfair Display', serif;
    }
    .no-scrollbar::-webkit-scrollbar { display: none; }
  </style>
</head>
<body class="min-h-screen text-slate-800 bg-slate-50 flex flex-col relative">

  <!-- AUDIO: Simplest possible — new Audio().play() works when Chrome Sound=Allow -->
  <script is:inline>
    window.playOrderNotificationSound = function(title, body) {
      // Simplest possible audio call — works from WebSocket callbacks when Chrome Sound=Allow
      var audio = new Audio('/sounds/order_chime.wav');
      audio.volume = 1.0;
      audio.play().then(function() {
        console.log('✅ Chime played!');
      }).catch(function(e) {
        console.warn('Audio play blocked:', e.message);
      });

      // Visual OS notification banner
      if (window.Notification && Notification.permission === 'granted') {
        try {
          var n = new Notification(title || '🛍️ New Order!', {
            body: body || 'A new customer order has arrived.',
            icon: '/favicon.ico',
            tag: 'oorumart-' + Date.now(),
            silent: true
          });
          n.onclick = function() { window.focus(); n.close(); };
        } catch(e) {}
      }
    };

    window.requestNotifPermission = async function() {
      if (!('Notification' in window)) return false;
      if (Notification.permission === 'granted') return true;
      if (Notification.permission !== 'denied') {
        return (await Notification.requestPermission()) === 'granted';
      }
      return false;
    };
  </script>

  <!-- AESTHETIC THEMED CONFIRMATION MODAL -->
  <div id="confirm-modal" class="fixed inset-0 bg-slate-950/75 backdrop-blur-sm z-[110] flex items-center justify-center p-4 opacity-0 pointer-events-none hidden transition-all duration-300">
    <div class="bg-white rounded-2xl max-w-sm w-full p-6 text-center space-y-4 shadow-2xl border border-slate-200 transform scale-95 transition-transform duration-300" id="confirm-card">
      <div id="confirm-icon" class="w-12 h-12 bg-rose-100 text-rose-600 rounded-full flex items-center justify-center text-2xl mx-auto font-bold">
        ⚠️
      </div>
      <div class="space-y-1">
        <h3 id="confirm-title" class="font-serif-title font-extrabold text-base text-slate-900 uppercase">Confirm Action</h3>
        <p id="confirm-message" class="text-xs text-slate-600 leading-relaxed">Are you sure you want to proceed?</p>
      </div>
      <div class="flex space-x-3 pt-2">
        <button id="confirm-cancel-btn" onclick="closeConfirmModal(false)" class="flex-1 py-2.5 bg-slate-100 hover:bg-slate-200 text-slate-700 font-bold text-xs uppercase tracking-wider rounded-lg transition-colors cursor-pointer">
          Cancel
        </button>
        <button id="confirm-action-btn" class="flex-1 py-2.5 bg-rose-600 hover:bg-rose-700 text-white font-bold text-xs uppercase tracking-wider rounded-lg transition-colors cursor-pointer shadow-sm">
          Delete
        </button>
      </div>
    </div>
  </div>

  <!-- AESTHETIC GLASSMORPHISM TOAST POPUP MODAL -->
  <div id="toast-modal" class="fixed inset-0 bg-slate-950/60 backdrop-blur-sm z-[100] flex items-center justify-center p-4 opacity-0 pointer-events-none hidden transition-all duration-300">
    <div class="bg-white rounded-2xl max-w-sm w-full p-6 text-center space-y-4 shadow-2xl border border-slate-200 transform scale-95 transition-transform duration-300" id="toast-card">
      <div id="toast-icon" class="w-12 h-12 bg-emerald-100 text-emerald-600 rounded-full flex items-center justify-center text-2xl mx-auto font-bold">
        ✅
      </div>
      <div class="space-y-1">
        <h3 id="toast-title" class="font-serif-title font-extrabold text-base text-slate-900 uppercase">Settings Saved</h3>
        <p id="toast-message" class="text-xs text-slate-500 leading-relaxed">Changes successfully synced to Supabase database.</p>
      </div>
      <button onclick="closeToastModal()" class="w-full py-2.5 bg-slate-900 text-white font-bold text-xs uppercase tracking-wider rounded-lg hover:bg-slate-800 transition-colors shadow-xs cursor-pointer">
        Continue
      </button>
    </div>
  </div>

  <!-- 1. VENDOR LOGIN MODAL -->
  <div id="admin-login-screen" class="fixed inset-0 bg-slate-950/80 z-50 flex items-center justify-center p-4">
    <div class="bg-white rounded-2xl max-w-md w-full p-6 sm:p-8 shadow-2xl space-y-6 border border-slate-200 relative">
      
      <!-- Close Exit Button -->
      <button onclick="window.location.href='/'" class="absolute top-4 right-4 w-8 h-8 rounded-full bg-slate-100 hover:bg-slate-200 text-slate-600 flex items-center justify-center transition-colors cursor-pointer" title="Exit to Oorumart Marketplace">
        ✕
      </button>

      <div class="text-center space-y-2">
        <div class="w-12 h-12 bg-slate-900 text-white font-extrabold rounded-xl mx-auto flex items-center justify-center text-xl font-serif-title shadow-md">
          OM
        </div>
        <h2 class="font-extrabold text-xl text-slate-900 tracking-wider font-serif-title uppercase">OORUMART VENDOR PORTAL</h2>
        <p class="text-xs text-slate-500">Log in to customize your store template, component carousels, live orders, and catalog.</p>
      </div>

      <form onsubmit="handleVendorLogin(event)" class="space-y-4 text-xs">
        <div>
          <label class="block font-bold text-slate-700 uppercase tracking-wider mb-1.5">Select Your Business Shop</label>
          <select id="login-shop-select" class="w-full px-3.5 py-3 border border-slate-300 rounded-lg font-bold text-slate-900 text-xs focus:outline-none focus:border-slate-900 bg-slate-50">
            {allShops.map((s: any) => (
              <option value={s.slug}>{s.name} ({s.slug}.oorumart.in)</option>
            ))}
          </select>
        </div>

        <div>
          <label class="block font-bold text-slate-700 uppercase tracking-wider mb-1.5">Store Admin Security PIN</label>
          <input id="login-pin-input" type="password" value="1234" required placeholder="Enter PIN (default: 1234)" class="w-full px-3.5 py-3 border border-slate-300 rounded-lg text-xs font-bold tracking-widest focus:outline-none focus:border-slate-900" />
        </div>

        <button type="submit" class="w-full py-3.5 bg-slate-900 hover:bg-slate-800 text-white font-extrabold text-xs uppercase tracking-wider rounded-lg shadow-lg cursor-pointer transition-all">
          Login to Vendor Dashboard &rarr;
        </button>
      </form>

      <div class="text-[11px] text-center text-slate-400 border-t border-slate-100 pt-3 flex items-center justify-between">
        <span>Protected Merchant Portal</span>
        <a href="/" class="text-rose-600 font-bold no-underline hover:underline">Exit to Marketplace ➔</a>
      </div>
    </div>
  </div>

  <!-- 2. VENDOR DASHBOARD HEADER -->
  <header class="bg-slate-900 text-white px-4 sm:px-8 py-3.5 flex items-center justify-between border-b border-slate-800 shadow-md">
    <div class="flex items-center space-x-3">
      <div id="active-vendor-avatar" class="w-9 h-9 rounded-lg bg-rose-600 flex items-center justify-center font-bold text-white text-sm shadow-sm uppercase">
        OM
      </div>
      <div>
        <h1 id="active-vendor-title" class="font-extrabold text-sm sm:text-base tracking-wider uppercase">Merchant Store</h1>
        <div class="flex items-center space-x-2 text-[11px] text-slate-400">
          <span class="w-2 h-2 rounded-full bg-emerald-500 animate-pulse"></span>
          <span>Active Subdomain: <code id="active-vendor-domain" class="text-slate-200 font-bold">oorumart.in</code></span>
        </div>
      </div>
    </div>

    <div class="flex items-center space-x-3">
      <button id="btn-test-sound" class="px-3 py-1.5 bg-amber-500 hover:bg-amber-600 text-white text-xs font-bold rounded cursor-pointer shadow-sm flex items-center space-x-1" title="Test Order Chime Sound">
        <span>🔔 Test Alert Sound</span>
      </button>
      <a id="live-shop-link" href="/" target="_blank" class="px-3.5 py-1.5 bg-emerald-600 hover:bg-emerald-700 text-white text-xs font-bold rounded border border-emerald-500 no-underline flex items-center space-x-1 shadow-sm">
        <span>View Live Storefront ↗</span>
      </a>
      <button onclick="logoutVendor()" class="px-3 py-1.5 bg-rose-950/80 hover:bg-rose-900 text-rose-200 text-xs font-bold rounded border border-rose-800 cursor-pointer">
        Switch Shop
      </button>
    </div>
  </header>

  <!-- 3. MAIN DASHBOARD NAVIGATION TABS -->
  <div class="flex-1 max-w-7xl w-full mx-auto px-4 sm:px-8 py-6 sm:py-8 space-y-6">

    <!-- Chrome macOS File Access Warning Banner (auto-detects Chrome, dismissible) -->
    <div id="chrome-file-warning" style="display:none;" class="bg-amber-50 border border-amber-300 rounded-xl p-4 flex items-start space-x-3">
      <span style="font-size:22px;">⚠️</span>
      <div class="flex-1">
        <div class="font-extrabold text-amber-900 text-sm uppercase tracking-wider">Chrome on Mac: Enable File Access for Photo Uploads</div>
        <div class="text-xs text-amber-800 mt-1 space-y-1">
          <p>If the <strong>Browse &amp; Choose Photo</strong> button does nothing when clicked, Chrome needs macOS permission to access your files.</p>
          <p class="font-bold">Fix: <span class="font-normal">Open <strong>System Settings → Privacy &amp; Security → Files and Folders</strong> → Enable <strong>Google Chrome</strong>. Then restart Chrome.</span></p>
          <p class="text-amber-600 text-[10px]">This is a macOS security requirement for all third-party browsers. Safari does not need this step.</p>
        </div>
      </div>
      <button onclick="dismissChromeWarning()" class="text-amber-600 hover:text-amber-900 font-bold text-lg cursor-pointer shrink-0" title="Dismiss">✕</button>
    </div>

    <div class="flex border-b border-slate-200 space-x-2 sm:space-x-6 text-xs sm:text-sm font-bold uppercase tracking-wider overflow-x-auto no-scrollbar">
      <button onclick="switchTab('orders')" id="tab-btn-orders" class="py-3 border-b-2 border-slate-900 text-slate-900 cursor-pointer flex items-center space-x-2 shrink-0">
        <span>📦 Real-Time Orders</span>
        <span id="admin-orders-count-badge" class="bg-rose-600 text-white text-[10px] px-2 py-0.5 rounded-full font-extrabold">0</span>
      </button>
      <button onclick="switchTab('categories')" id="tab-btn-categories" class="py-3 border-b-2 border-transparent text-slate-500 hover:text-slate-900 cursor-pointer flex items-center space-x-2 shrink-0">
        <span>🖼️ Category Carousels & Cover Uploads</span>
      </button>
      <button onclick="switchTab('banners')" id="tab-btn-banners" class="py-3 border-b-2 border-transparent text-slate-500 hover:text-slate-900 cursor-pointer flex items-center space-x-2 shrink-0">
        <span>🎨 Tagged Offer Canvases</span>
      </button>
      <button onclick="switchTab('products')" id="tab-btn-products" class="py-3 border-b-2 border-transparent text-slate-500 hover:text-slate-900 cursor-pointer flex items-center space-x-2 shrink-0">
        <span>🛍️ Products (<span id="products-count-label">0</span>)</span>
      </button>
      <button onclick="switchTab('add-product')" id="tab-btn-add-product" class="py-3 border-b-2 border-transparent text-slate-500 hover:text-slate-900 cursor-pointer flex items-center space-x-2 shrink-0">
        <span>➕ Add / Edit Product</span>
      </button>
      <button onclick="switchTab('settings')" id="tab-btn-settings" class="py-3 border-b-2 border-transparent text-slate-500 hover:text-slate-900 cursor-pointer flex items-center space-x-2 shrink-0">
        <span>⚙️ Template Style & Colors</span>
      </button>
    </div>

    <!-- SECTION 1: REAL-TIME ORDERS TAB -->
    <div id="tab-orders" class="space-y-4">
      <div class="flex items-center justify-between">
        <div class="flex items-center space-x-2">
          <h2 class="font-serif-title text-xl font-bold text-slate-900 uppercase">LIVE ORDERS FEED</h2>
          <span class="bg-emerald-100 text-emerald-800 text-[10px] font-bold px-2 py-0.5 rounded animate-pulse">Supabase Realtime Socket Active</span>
        </div>
        <button onclick="loadAdminOrders()" class="px-3 py-1.5 bg-slate-100 hover:bg-slate-200 text-slate-800 text-xs font-bold rounded cursor-pointer">
          🔄 Refresh Orders
        </button>
      </div>

      <div id="admin-orders-list" class="space-y-4"></div>
    </div>

    <!-- SECTION 2: CATEGORY CAROUSEL & COVER UPLOAD MANAGER -->
    <div id="tab-categories" class="space-y-6" style="height:0;overflow:hidden;visibility:hidden;position:absolute;pointer-events:none;opacity:0;">
      <div>
        <h2 class="font-serif-title text-xl font-bold text-slate-900 uppercase">CATEGORY CAROUSELS & COVER PHOTO MANAGER</h2>
        <p class="text-xs text-slate-500 mt-1">Configure individual category carousel sections, set matching tags, and upload cloud cover photos.</p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <!-- Category Add/Edit Form -->
        <div class="bg-white p-6 rounded-xl border border-slate-200 shadow-xs space-y-4 text-xs">
          <h3 id="cat-form-title" class="font-bold text-sm text-slate-900 uppercase">Add / Update Category Carousel</h3>
          
          <form onsubmit="handleSaveCategory(event)" enctype="multipart/form-data" class="space-y-4">
            <input id="cat-id-input" type="hidden" />

            <div>
              <label class="block font-bold text-slate-700 uppercase tracking-wider mb-1">Category Title / Label</label>
              <input id="cat-label-input" type="text" required placeholder="e.g. Silk Sarees & Lehengas" class="w-full px-3.5 py-2.5 border border-slate-300 rounded focus:outline-none focus:border-slate-900" />
            </div>

            <div>
              <label class="block font-bold text-slate-700 uppercase tracking-wider mb-1">Target Tag Code (Layer 2 DSL)</label>
              <input id="cat-tag-input" type="text" required placeholder="e.g. silk_sarees, mugs, sweets" class="w-full px-3.5 py-2.5 border border-slate-300 rounded focus:outline-none focus:border-slate-900 font-mono text-[11px]" />
              <p class="text-[10px] text-slate-400 mt-1">Products matching this tag code will automatically render inside this category carousel.</p>
            </div>

            <!-- Bare-minimum file upload: label text directly (no child span), input as sibling -->
            <div class="space-y-2">
              <label class="block font-bold text-slate-700 uppercase tracking-wider">Category Cover Photo Upload</label>
              
              <label for="cat-file-input" style="display:inline-block;padding:10px 16px;background:#0f172a;color:#fff;font-size:11px;font-weight:800;text-transform:uppercase;letter-spacing:.05em;border-radius:6px;cursor:pointer;user-select:none;">🖼️ Browse &amp; Choose Photo</label>
              <input id="cat-file-input" type="file" accept="image/*" onchange="previewCatImage(event)" style="position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0;" />
              <span id="cat-file-label" style="font-size:11px;color:#64748b;font-weight:700;margin-left:8px;">No file chosen</span>

              <div style="margin-top:6px;">
                <div style="font-size:10px;color:#94a3b8;font-weight:700;text-transform:uppercase;letter-spacing:.05em;margin-bottom:4px;">Or Paste Image URL Directly:</div>
                <input type="text" placeholder="https://images.unsplash.com/photo-..." oninput="document.getElementById('cat-image-url').value = this.value" class="w-full px-3 py-2 border border-slate-300 rounded text-xs focus:outline-none focus:border-slate-900 font-mono" />
              </div>

              <div id="cat-upload-preview" class="mt-2"></div>
              <input id="cat-image-url" type="hidden" />
            </div>

            <button id="cat-submit-btn" type="submit" class="w-full py-3 bg-slate-900 hover:bg-slate-800 text-white font-extrabold text-xs uppercase tracking-wider rounded cursor-pointer shadow-md">
              Save Category Carousel to Supabase
            </button>
          </form>
        </div>

        <!-- Current Category List Grid -->
        <div class="md:col-span-2 space-y-3">
          <h3 class="font-bold text-sm text-slate-900 uppercase">Active Template Categories</h3>
          <div id="admin-categories-grid" class="grid grid-cols-1 sm:grid-cols-2 gap-4"></div>
        </div>
      </div>
    </div>

    <!-- SECTION 3: TAGGED OFFER CANVASES TAB -->
    <div id="tab-banners" class="space-y-6" style="height:0;overflow:hidden;visibility:hidden;position:absolute;pointer-events:none;opacity:0;">
      <div>
        <h2 class="font-serif-title text-xl font-bold text-slate-900 uppercase">TAGGED HERO CAROUSEL & OFFER CANVASES</h2>
        <p class="text-xs text-slate-500 mt-1">Manage top homepage offer slides and attach product filter tags so clicking the banner displays targeted sale items.</p>
      </div>

      <div class="grid grid-cols-1 md:grid-cols-3 gap-6">
        <!-- Add New Hero Banner Form -->
        <div class="bg-white p-6 sm:p-8 rounded-xl border border-slate-200 shadow-xs space-y-4 text-xs">
          <h3 class="font-bold text-sm text-slate-900 uppercase">Add Offer Banner Slide</h3>

          <form onsubmit="handleSaveHeroBanner(event)" enctype="multipart/form-data" class="space-y-4">
            <div>
              <label class="block font-bold text-slate-700 uppercase tracking-wider mb-1">Offer Banner Title</label>
              <input id="banner-title" type="text" required placeholder="e.g. Exclusive Festive Sale" class="w-full px-3.5 py-2.5 border border-slate-300 rounded focus:outline-none focus:border-slate-900" />
            </div>

            <div>
              <label class="block font-bold text-slate-700 uppercase tracking-wider mb-1">Subtitle / Offer Description</label>
              <input id="banner-subtitle" type="text" placeholder="e.g. Up to 40% OFF on all handcrafted items this weekend" class="w-full px-3.5 py-2.5 border border-slate-300 rounded focus:outline-none focus:border-slate-900" />
            </div>

            <div class="grid grid-cols-2 gap-4">
              <div>
                <label class="block font-bold text-slate-700 uppercase tracking-wider mb-1">Attached Filter Tag Code</label>
                <input id="banner-cta-link" type="text" value="festive_sale" placeholder="e.g. 10%_off, b2g1, bestseller" class="w-full px-3.5 py-2.5 border border-slate-300 rounded font-mono text-[11px] focus:outline-none focus:border-slate-900" />
              </div>
              <div>
                <label class="block font-bold text-slate-700 uppercase tracking-wider mb-1">CTA Button Text</label>
                <input id="banner-cta-text" type="text" value="Shop Festive Offer" class="w-full px-3.5 py-2.5 border border-slate-300 rounded focus:outline-none focus:border-slate-900" />
              </div>
            </div>

            <div>
              <label class="block font-bold text-slate-700 uppercase tracking-wider mb-1">Background Gradient Theme</label>
              <select id="banner-gradient" class="w-full px-3.5 py-2.5 border border-slate-300 rounded focus:outline-none focus:border-slate-900">
                <option value="from-slate-900 to-teal-900">Teal Dark Gradient</option>
                <option value="from-emerald-900 to-slate-900">Emerald Dark Gradient</option>
                <option value="from-purple-950 to-slate-900">Royal Purple Gradient</option>
                <option value="from-rose-950 to-slate-900">Rose Crimson Gradient</option>
              </select>
            </div>

            <!-- Bare-minimum file upload -->
            <div class="space-y-2">
              <label class="block font-bold text-slate-700 uppercase tracking-wider">Offer Banner Photo Upload</label>

              <label for="banner-file" style="display:inline-block;padding:10px 16px;background:#0f172a;color:#fff;font-size:11px;font-weight:800;text-transform:uppercase;letter-spacing:.05em;border-radius:6px;cursor:pointer;user-select:none;">🖼️ Browse &amp; Choose Photo</label>
              <input id="banner-file" type="file" accept="image/*" onchange="previewBannerImage(event)" style="position:absolute;width:1px;height:1px;padding:0;margin:-1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap;border:0;" />
              <span id="banner-file-label" style="font-size:11px;color:#64748b;font-weight:700;margin-left:8px;">No file chosen</span>

              <div style="margin-top:6px;">
                <div style="font-size:10px;color:#94a3b8;font-weight:700;text-transform:uppercase;letter-spacing:.05em;margin-bottom:4px;">Or Paste Image URL Directly:</div>
                <input type="text" placeholder="https://images.unsplash.com/photo-..." oninput="document.getElementById('banner-image-url').value = this.value" class="w-full px-3 py-2 border border-slate-300 rounded text-xs focus:outline-none focus:border-slate-900 font-mono" />
              </div>

              <div id="banner-upload-preview" class="mt-2"></div>
              <input id="banner-image-url" type="hidden" />
            </div>

            <button type="submit" class="w-full py-3.5 bg-slate-900 hover:bg-slate-800 text-white font-extrabold text-xs uppercase tracking-wider rounded cursor-pointer shadow-md">
              Publish Tagged Banner Slide to Supabase
            </button>
          </form>
        </div>

        <!-- Published Banners Grid -->
        <div class="md:col-span-2 space-y-3">
          <h3 class="font-bold text-sm text-slate-900 uppercase">Published Homepage Offer Slides</h3>
          <div id="admin-banners-grid" class="space-y-3"></div>
        </div>
      </div>
    </div>

    <!-- SECTION 4: CATALOG PRODUCTS TAB -->
    <div id="tab-products" class="space-y-4" style="height:0;overflow:hidden;visibility:hidden;position:absolute;pointer-events:none;opacity:0;">
      <div class="flex flex-col sm:flex-row sm:items-center justify-between gap-3">
        <div>
          <h2 class="font-serif-title text-xl font-bold text-slate-900 uppercase">STORE PRODUCTS</h2>
          <p class="text-xs text-slate-500">Manage catalog products, bulk select items, and delete or update active status.</p>
        </div>
        <button onclick="switchTab('add-product')" class="px-4 py-2 bg-slate-900 text-white font-bold text-xs uppercase tracking-wider rounded cursor-pointer hover:bg-slate-800 shrink-0">
          + Add Product
        </button>
      </div>

      <!-- Filter, Search & Bulk Actions Toolbar -->
      <div class="bg-white p-4 rounded-xl border border-slate-200 shadow-xs flex flex-wrap items-center justify-between gap-3 text-xs">
        <div class="flex flex-wrap items-center gap-2">
          <!-- Search input -->

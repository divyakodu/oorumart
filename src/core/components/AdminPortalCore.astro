    window.handleSaveCategory = async function(e) {
      if (e) e.preventDefault();
      if (!currentShop) return;

      const id = document.getElementById('cat-id-input').value;
      const label = document.getElementById('cat-label-input').value;
      const tag = document.getElementById('cat-tag-input').value;
      const image_url = document.getElementById('cat-image-url').value;

      // If editing an existing category and no new image was chosen, preserve the existing image_url
      let finalImageUrl = image_url;
      if (!finalImageUrl && id) {
        const existing = (currentShop.categories || []).find(c => c.id === id);
        if (existing) finalImageUrl = existing.image_url || '';
      }

      console.log('💾 HTTP POST to /api/categories:', { shop_slug: currentShop.slug, id, label, tag, hasImage: !!finalImageUrl });

      try {
        const res = await fetch('/api/categories', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            shop_slug: currentShop.slug,
            id,
            label,
            tag,
            image_url: finalImageUrl
          })
        });

        const data = await res.json();
        console.log('✅ Response from /api/categories:', data);
        const savedUrl = data.image_url || finalImageUrl;
        const savedId = id || data.id;

        // Update local in-memory cache immediately
        const existingIdx = (currentShop.categories || []).findIndex(c => c.id === savedId);
        if (existingIdx >= 0) {
          currentShop.categories[existingIdx] = { id: savedId, label, tag, image_url: savedUrl };
        } else {
          if (!currentShop.categories) currentShop.categories = [];
          currentShop.categories.push({ id: savedId, label, tag, image_url: savedUrl });
        }

        // Re-render admin grid immediately
        window.renderAdminCategories();

        // Reset form
        window.resetCategoryForm();

        window.showToast('Category Saved', `Category "${label}" saved to Supabase! Refresh your storefront page to see live changes.`, '🖼️');
      } catch (err) {
        console.error('❌ Error saving category:', err);
        window.showToast('Error', 'Failed to save category.', '❌');
      }
    };


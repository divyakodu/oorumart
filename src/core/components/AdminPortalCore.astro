              <td class="p-3 font-bold text-slate-900 max-w-xs truncate">${p.name}</td>
              <td class="p-3 text-slate-600 uppercase font-semibold text-[11px]">${p.category_id}</td>
              <td class="p-3 font-bold">
                <span class="text-rose-600">₹ ${p.price}</span>
                ${p.mrp ? `<span class="line-through text-slate-400 text-[11px] ml-1">₹ ${p.mrp}</span>` : ''}
              </td>
              <td class="p-3">
                <div class="flex flex-wrap gap-1">
                  ${p.badge ? `<span class="bg-slate-900 text-white text-[9px] font-bold px-1.5 py-0.5 rounded uppercase">${p.badge}</span>` : ''}
                  ${Array.isArray(p.tags) ? p.tags.map((t) => `<span class="bg-slate-100 text-slate-700 text-[9px] font-bold px-1.5 py-0.5 rounded border border-slate-300">${t}</span>`).join('') : ''}

    window.filterAdminProducts = function() {
      if (!currentShop) return;

      const prods = currentShop.products || [];
      const searchVal = (document.getElementById('admin-prod-search')?.value || '').toLowerCase();
      const catVal = document.getElementById('admin-prod-cat-filter')?.value || 'all';
      const statusVal = document.getElementById('admin-prod-status-filter')?.value || 'all';

      const filtered = prods.filter(p => {
        if (searchVal) {
          const matchName = (p.name || '').toLowerCase().includes(searchVal);
          const matchCat = (p.category_id || '').toLowerCase().includes(searchVal);
          const matchBadge = (p.badge || '').toLowerCase().includes(searchVal);
          if (!matchName && !matchCat && !matchBadge) return false;
        }

        if (catVal !== 'all' && p.category_id !== catVal && !(Array.isArray(p.tags) && p.tags.includes(catVal))) {
          return false;
        }

        if (statusVal === 'active' && p.is_active === false) return false;
        if (statusVal === 'hidden' && p.is_active !== false) return false;

        return true;
      });

      const countLabel = document.getElementById('products-count-label');
      if (countLabel) countLabel.innerText = filtered.length;

      const tbody = document.getElementById('admin-product-table-body');
      if (tbody) {
        if (filtered.length === 0) {
          tbody.innerHTML = `<tr><td colspan="8" class="p-6 text-center text-xs text-slate-500 font-medium">No products match your search or filter criteria.</td></tr>`;

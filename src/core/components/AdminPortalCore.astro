    window.compressImageFile = function(file, callback) {
      if (!file) return;
      console.log('🖼️ Compressing image file:', file.name, `${Math.round(file.size / 1024)} KB`);

      // Check for HEIC/HEIF - Chrome Canvas cannot decode these
      const isHeic = file.type === 'image/heic' || file.type === 'image/heif'
        || file.name.toLowerCase().endsWith('.heic') || file.name.toLowerCase().endsWith('.heif');

      if (isHeic) {
        console.warn('⚠️ HEIC format detected. Chrome cannot process HEIC files natively.');
        window.showToast(
          '⚠️ Unsupported Format',
          'HEIC/iPhone photos cannot be uploaded directly. Please convert to JPEG first: open in Photos app → Share → Save as JPEG.',
          '📸'
        );
        callback(null); // Signal failure cleanly
        return;
      }

      const reader = new FileReader();
      reader.onload = function(e) {
        const img = new Image();
        img.onload = function() {
          const canvas = document.createElement('canvas');
          let width = img.width;
          let height = img.height;
          const maxDim = 800;

          if (width > maxDim || height > maxDim) {
            if (width > height) {
              height = Math.round((height * maxDim) / width);
              width = maxDim;
            } else {
              width = Math.round((width * maxDim) / height);
              height = maxDim;
            }
          }

          canvas.width = width;
          canvas.height = height;
          const ctx = canvas.getContext('2d');
          ctx.drawImage(img, 0, 0, width, height);

          const compressedDataUrl = canvas.toDataURL('image/jpeg', 0.85);
          console.log('✅ Image compressed to JPEG ~80KB. Ready for cloud upload.');
          callback(compressedDataUrl);
        };
        img.onerror = function() {
          // Canvas can't decode this format either
          window.showToast(
            '⚠️ Format Not Supported',
            'This image format cannot be processed by your browser. Please use JPEG, PNG, or WebP.',
            '📸'
          );
          callback(null); // Signal failure cleanly - do NOT pass raw blob to DB
        };
        img.src = e.target.result;
      };
      reader.onerror = function() {
        window.showToast('Error', 'Could not read the selected file.', '❌');
        callback(null);
      };
      reader.readAsDataURL(file);
    };


    window.handleAddNewProduct = async function(e) {
      if (e) e.preventDefault();
      if (!currentShop) return;

      const prodId = document.getElementById('edit-prod-id').value;
      const name = document.getElementById('new-prod-name').value;
      const price = document.getElementById('new-prod-price').value;
      const mrp = document.getElementById('new-prod-mrp').value;
      const category_id = document.getElementById('new-prod-category').value;
      const image_url = document.getElementById('new-prod-image-url').value;

      let finalUrl = image_url;
      if (!finalUrl && prodId) {
        const existing = (currentShop.products || []).find(p => p.id === prodId);
        if (existing) finalUrl = existing.image_url || '';
      }

      const tags = [category_id];

      try {
        const res = await fetch('/api/products', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({
            shop_slug: currentShop.slug,
            id: prodId || undefined,
            name,
            price,
            mrp,
            category_id,
            badge: tags[0] || null,
            tags,
            image_url: finalUrl
          })
        });

        const data = await res.json();
        finalUrl = data.image_url || finalUrl;

        const existingIdx = (currentShop.products || []).findIndex(p => p.id === (prodId || data.id));
        if (existingIdx >= 0) {
          currentShop.products[existingIdx] = {
            id: prodId || data.id,
            name,
            price: Number(price),
            mrp: Number(mrp || price),
            category_id,
            badge: tags[0] || null,
            tags,
            image_url: finalUrl,
            is_active: true
          };
        } else {
          if (!currentShop.products) currentShop.products = [];
          currentShop.products.push({
            id: data.id || `prod_${Date.now()}`,
            name,
            price: Number(price),
            mrp: Number(mrp || price),
            category_id,
            badge: tags[0] || null,
            tags,
            image_url: finalUrl,
            is_active: true
          });
        }

        window.renderAdminProducts();
        document.getElementById('edit-prod-id').value = '';
        document.getElementById('new-prod-name').value = '';
        document.getElementById('new-prod-price').value = '';
        document.getElementById('new-prod-mrp').value = '';
        document.getElementById('image-upload-preview').innerHTML = '';
        document.getElementById('add-prod-heading').innerText = 'ADD NEW PRODUCT';

        window.showToast('Product Saved', `"${name}" published live to Supabase for ${currentShop.name}!`, '🛍️');
        window.switchTab('products');
      } catch (err) {
        console.error('❌ Error saving product:', err);
        window.showToast('Error', 'Failed to publish product to cloud.', '❌');
      }
    };


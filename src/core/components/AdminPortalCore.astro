    window.switchTab = function(tabId) {
      console.log('📂 Switching Admin Tab to:', tabId);
      ['orders', 'categories', 'banners', 'products', 'add-product', 'settings'].forEach(t => {
        const tab = document.getElementById(`tab-${t}`);
        const btn = document.getElementById(`tab-btn-${t}`);
        if (t === tabId) {
          // ACTIVE: fully visible in normal document flow
          if (tab) {
            tab.style.height = 'auto';
            tab.style.overflow = 'visible';
            tab.style.visibility = 'visible';
            tab.style.position = 'static';
            tab.style.pointerEvents = 'auto';
            tab.style.opacity = '1';
          }
          btn?.classList.add('border-slate-900', 'text-slate-900');
          btn?.classList.remove('border-transparent', 'text-slate-500');
        } else {
          // INACTIVE: zero height, clipped, invisible — but NOT display:none!
          // Chrome requires file inputs to never have a display:none ancestor
          // or the native file picker will be blocked silently.
          if (tab) {
            tab.style.height = '0';
            tab.style.overflow = 'hidden';
            tab.style.visibility = 'hidden';
            tab.style.position = 'absolute';
            tab.style.pointerEvents = 'none';
            tab.style.opacity = '0';
          }
          btn?.classList.remove('border-slate-900', 'text-slate-900');
          btn?.classList.add('border-transparent', 'text-slate-500');
        }
      });
    };


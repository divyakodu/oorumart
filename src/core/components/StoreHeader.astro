---
export interface Props {
  shop: {
    slug: string;
    name: string;
    logo_url?: string;
    logo_animated_url?: string;
    logo_text?: string;
    announcement_text?: string;
    categories?: Array<{ id: string; label: string }>;
  };
  primaryColor?: string;
}

const { shop, primaryColor = '#581C87' } = Astro.props;
const categories = shop.categories || [];
const logoImg = shop?.logo_animated_url || shop?.logo_url;
const logoText = shop?.logo_text || shop?.name;
---

<!-- 1. Top Announcement Bar (High Contrast WCAG AAA Readability) -->
<div style={`background-color: ${primaryColor}`} class="text-slate-100 text-xs font-semibold py-2.5 px-4 flex items-center justify-between shadow-xs select-none border-b border-slate-800">
  <button class="hover:text-amber-400 cursor-pointer px-2 text-xs font-bold text-amber-400" title="Previous">◀</button>
  <span class="tracking-widest text-center flex-1 font-semibold uppercase text-slate-100">{shop.announcement_text || `FREE SHIPPING ON ORDERS ABOVE ₹999 | EXPRESS STORE PICKUP`}</span>
  <button class="hover:text-amber-400 cursor-pointer px-2 text-xs font-bold text-amber-400" title="Next">▶</button>
</div>

<!-- 2. Generic Reusable Header Nav -->
<header class="sticky top-0 z-40 bg-white border-b border-slate-200 px-4 sm:px-6 py-3 shadow-xs">
  <div class="max-w-7xl mx-auto flex items-center justify-between gap-4 sm:gap-6 h-14">
    
    <!-- Brand Logo -->
    <a href="/" class="flex items-center space-x-3 shrink-0 no-underline group leading-none my-auto">
      {logoImg && (
        <img src={logoImg} alt={shop.name} class="h-10 sm:h-11 w-auto object-contain group-hover:scale-105 transition-transform shrink-0 -translate-y-2" />
      )}
      <span class="font-extrabold text-xl sm:text-2xl tracking-[0.15em] text-slate-900 font-serif-title uppercase leading-none my-auto">{logoText}</span>
    </a>

    <!-- Desktop Category Navigation Tabs (Visible ONLY on Desktop ≥ 1024px) -->
    <nav class="hidden lg:flex items-center space-x-3.5 xl:space-x-5 text-xs text-slate-800 my-auto whitespace-nowrap shrink-0">
      {categories.map((c: any, index: number) => (
        <a 
          href={`/catalog?category=${c.id}`} 
          class={`cursor-pointer no-underline transition-colors py-1 whitespace-nowrap shrink-0 ${
            index === 0 || c.label.toLowerCase().includes('all product')
              ? 'text-rose-600 font-extrabold hover:text-rose-700' 
              : 'text-slate-800 hover:text-rose-600 font-bold'
          }`}
        >
          {c.label}
        </a>
      ))}
    </nav>

    <!-- Right Actions: Desktop Search Bar + Track Order + Cart Drawer -->
    <div class="flex items-center space-x-3 sm:space-x-4 shrink-0 my-auto">
      <!-- Desktop Search Bar (Visible ONLY on Desktop ≥ 1024px) -->
      <form action="/catalog" method="GET" class="hidden lg:flex items-center relative">
        <div class="relative flex items-center">
          <svg class="w-4 h-4 text-slate-800 absolute left-2.5 pointer-events-none" fill="none" stroke="currentColor" viewBox="0 0 24 24">
            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
          </svg>
          <input 
            id="header-animated-search-input"
            type="text" 
            name="search" 
            placeholder="Search For Gift Sets..." 
            class="w-44 md:w-60 pl-9 pr-3 py-2 bg-white text-xs font-medium text-slate-900 placeholder-slate-500 rounded-none border border-slate-900 focus:outline-none focus:ring-1 focus:ring-slate-900 transition-all shadow-2xs"
          />
        </div>
      </form>

      <!-- Track Order Button -->
      <button onclick="toggleTrackDrawer(true)" class="text-slate-800 hover:text-slate-900 cursor-pointer p-1.5 hover:bg-slate-100 rounded-full transition-colors" title="Track Your Order">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"/></svg>
      </button>

      <!-- Cart Drawer Button -->
      <button onclick="toggleCartDrawer(true)" class="relative text-slate-800 hover:text-slate-900 cursor-pointer p-1.5 hover:bg-slate-100 rounded-full transition-colors">
        <svg class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z"/></svg>
        <span id="cart-count-badge" class="absolute -top-0.5 -right-0.5 bg-rose-600 text-white text-[10px] font-bold w-4 h-4 rounded-full flex items-center justify-center">0</span>
      </button>
    </div>
  </div>
</header>

<!-- 3. Mobile Search Bar Component (Visible ONLY on Small Screens < 1024px, Placed Just Below Header) -->
<div class="lg:hidden bg-slate-50 border-b border-slate-200 px-3 sm:px-4 py-2.5 shadow-2xs">
  <form action="/catalog" method="GET" class="flex items-center space-x-2">
    <div class="relative flex-1 flex items-center">
      <svg class="w-4 h-4 text-slate-800 absolute left-3 pointer-events-none shrink-0" fill="none" stroke="currentColor" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
      </svg>
      <input 
        id="mobile-header-search-input"
        type="text" 
        name="search" 
        placeholder="Search For Gift Sets, Home Decor..." 
        class="w-full pl-9 pr-3 py-2 bg-white text-xs font-medium text-slate-900 placeholder-slate-500 rounded border border-slate-900 focus:outline-none focus:ring-1 focus:ring-slate-900"
      />
    </div>
    <button type="submit" class="px-4 py-2 bg-slate-900 text-white font-extrabold text-xs uppercase tracking-wider rounded shrink-0 cursor-pointer hover:bg-slate-800">
      SEARCH
    </button>
  </form>
</div>

<!-- 4. Mobile Sticky Bottom Category Tab Section (Fixed at Bottom of Screen, Visible ONLY on Small Screens < 1024px) -->
<nav class="lg:hidden fixed bottom-0 left-0 right-0 z-50 bg-white/95 backdrop-blur-md border-t border-slate-300 shadow-xl px-3 py-2 overflow-x-auto whitespace-nowrap flex items-center space-x-2">
  {categories.map((c: any, index: number) => (
    <a 
      href={`/catalog?category=${c.id}`} 
      class={`cursor-pointer no-underline text-[11px] font-bold px-3 py-1.5 rounded-full transition-all shrink-0 border ${
        index === 0 || c.label.toLowerCase().includes('all product')
          ? 'bg-rose-600 text-white border-rose-600 shadow-xs' 
          : 'bg-slate-100 text-slate-800 border-slate-200 hover:bg-slate-900 hover:text-white'
      }`}
    >
      {c.label}
    </a>
  ))}
</nav>

<!-- Track Order Drawer Component (Rendered Everywhere StoreHeader is Included) -->
<div id="track-overlay" onclick="toggleTrackDrawer(false)" class="fixed inset-0 bg-slate-950/60 z-50 opacity-0 pointer-events-none transition-opacity duration-300"></div>
<aside id="track-drawer" class="fixed top-0 right-0 bottom-0 w-[80vw] max-w-sm sm:w-96 bg-white z-50 transform translate-x-full transition-transform duration-300 shadow-2xl flex flex-col justify-between p-4 sm:p-6">
  <div class="space-y-6">
    <div class="flex items-center justify-between border-b border-slate-200 pb-4">
      <div class="flex items-center space-x-2">
        <svg class="w-5 h-5 text-slate-900" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z"/></svg>
        <h3 class="font-extrabold text-sm uppercase tracking-wider text-slate-900">Track Your Order</h3>
      </div>
      <button onclick="toggleTrackDrawer(false)" class="w-8 h-8 rounded-full bg-slate-100 hover:bg-slate-200 text-slate-600 flex items-center justify-center transition-colors cursor-pointer" title="Close">✕</button>
    </div>

    <p class="text-xs text-slate-600">Enter your phone number or Order ID to check real order status.</p>

    <div class="space-y-3">
      <input id="track-input" type="text" placeholder="Enter Phone (e.g. 8197921458)" class="w-full px-3 py-2 border border-slate-300 rounded text-xs focus:outline-none focus:border-slate-900" />
      <button onclick="lookupOrderStatus()" class="w-full py-2.5 bg-slate-900 text-white font-bold text-xs uppercase tracking-wider rounded cursor-pointer hover:bg-slate-800">Check Status</button>
    </div>

    <div id="track-status-box" class="pt-4 border-t border-slate-200 text-xs">
      <div class="text-center py-6 border border-dashed border-slate-300 rounded-lg space-y-1">
        <div class="text-2xl">📦</div>
        <div class="font-bold text-slate-700">No Active Order Selected</div>
        <div class="text-[11px] text-slate-400">Enter your phone number above to view live status.</div>
      </div>
    </div>
  </div>

  <div class="text-xs text-center text-slate-500 border-t border-slate-200 pt-4">
    Need store help? Call: <a href="tel:+918197921458" class="font-bold text-slate-900">+91 8197921458</a>
  </div>
</aside>

<!-- Cart Drawer Component (80vw Width on Mobile, Fixed w-96 on Desktop) -->
<div id="cart-overlay" onclick="toggleCartDrawer(false)" class="fixed inset-0 bg-slate-950/60 z-50 opacity-0 pointer-events-none transition-opacity duration-300"></div>
<aside id="cart-drawer" class="fixed top-0 right-0 bottom-0 w-[80vw] max-w-sm sm:w-96 bg-white z-50 transform translate-x-full transition-transform duration-300 shadow-2xl flex flex-col justify-between">
  
  <div class="p-4 border-b border-slate-200 flex items-center justify-between bg-slate-50">
    <div class="flex items-center space-x-2">
      <svg class="w-5 h-5 text-slate-900" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 11V7a4 4 0 00-8 0v4M5 9h14l1 12H4L5 9z"/></svg>
      <span class="font-extrabold text-sm uppercase tracking-wider text-slate-900">Your Cart</span>
      <span id="cart-header-badge" class="bg-slate-900 text-white text-[11px] font-bold px-2 py-0.5 rounded-full">0 ITEMS</span>
    </div>
    <button onclick="toggleCartDrawer(false)" class="w-8 h-8 rounded-full bg-white hover:bg-slate-200 text-slate-700 border border-slate-200 flex items-center justify-center transition-colors cursor-pointer" title="Close Cart">✕</button>
  </div>

  <div class="bg-slate-900 text-white text-xs font-semibold py-2 px-4 text-center">
    Save more on Prepaid Orders & Instant WhatsApp Checkout!
  </div>

  <div class="flex-1 overflow-y-auto p-4 space-y-4">
    <div id="cart-items-list" class="space-y-3"></div>

    <div class="pt-4 border-t border-slate-200 space-y-3">
      <h4 class="text-xs font-extrabold uppercase tracking-wider text-slate-900">Customer Delivery Info</h4>
      <div class="space-y-2">
        <input id="checkout-name" type="text" placeholder="Enter Full Name (e.g. Divya Kodukula)" class="w-full px-3 py-2 border border-slate-300 rounded text-xs focus:outline-none focus:border-slate-900" />
        <input id="checkout-phone" type="text" placeholder="Enter Phone Number (e.g. 8197921458)" class="w-full px-3 py-2 border border-slate-300 rounded text-xs focus:outline-none focus:border-slate-900" />
        <input id="checkout-address" type="text" placeholder="Enter Delivery Address / Store Pickup" class="w-full px-3 py-2 border border-slate-300 rounded text-xs focus:outline-none focus:border-slate-900" />
      </div>
    </div>
  </div>

  <div class="p-4 border-t border-slate-200 bg-slate-50 space-y-3">
    <div class="pt-2 space-y-2">
      <div class="flex items-center justify-between font-bold text-slate-900 text-sm">
        <span>Estimated Total</span>
        <span id="cart-total-price">₹ 0</span>
      </div>

      <button 
        onclick="placeRealWhatsAppOrder()"
        class="w-full py-3.5 bg-slate-900 hover:bg-slate-800 text-white font-extrabold text-xs uppercase tracking-wider rounded flex items-center justify-center space-x-2 cursor-pointer shadow-md"
      >
        <span>Place Order & Open WhatsApp (COD)</span>
      </button>
    </div>
  </div>

</aside>

<script is:inline>
  // Typewriter Animated Placeholder Script for Header Search Bars
  (function() {
    const desktopInput = document.getElementById('header-animated-search-input');
    const mobileInput = document.getElementById('mobile-header-search-input');
    const inputs = [desktopInput, mobileInput].filter(Boolean);

    if (inputs.length > 0) {
      const phrases = [
        "Search For Gift Sets...",
        "Search For Home & Decor...",
        "Search For Bags & Travel...",
        "Search For Board Games...",
        "Search For Action Toys...",
        "Search For Lunch Boxes..."
      ];

      let phraseIndex = 0;
      let charIndex = 0;
      let isDeleting = false;
      let typeSpeed = 100;

      function typeEffect() {
        const currentPhrase = phrases[phraseIndex];
        const textToShow = isDeleting 
          ? currentPhrase.substring(0, charIndex - 1) 
          : currentPhrase.substring(0, charIndex + 1);

        inputs.forEach(input => {
          if (document.activeElement !== input || input.value.length === 0) {
            input.placeholder = textToShow;
          }
        });

        if (isDeleting) {
          charIndex--;
          typeSpeed = 40;
        } else {
          charIndex++;
          typeSpeed = 90;
        }

        if (!isDeleting && charIndex === currentPhrase.length) {
          typeSpeed = 1800;
          isDeleting = true;
        } else if (isDeleting && charIndex === 0) {
          isDeleting = false;
          phraseIndex = (phraseIndex + 1) % phrases.length;
          typeSpeed = 400;
        }

        setTimeout(typeEffect, typeSpeed);
      }

      typeEffect();
    }
  })();

  // Robust Global Order Tracking Function
  window.lookupOrderStatus = async function() {
    const input = document.getElementById('track-input')?.value.trim();
    const statusBox = document.getElementById('track-status-box');
    if (!input || !statusBox) return;

    statusBox.innerHTML = `
      <div class="text-center py-6 space-y-2">
        <div class="text-2xl animate-spin">⏳</div>
        <div class="font-bold text-slate-800 text-xs">Checking live order status...</div>
      </div>
    `;

    let foundOrders = [];

    // 1. Check local storage first
    try {
      const localSaved = localStorage.getItem('yesfancy_orders') || localStorage.getItem('oorumart_orders');
      if (localSaved) {
        const parsed = JSON.parse(localSaved);
        if (Array.isArray(parsed)) {
          foundOrders = parsed.filter(o => (o.phone && o.phone.includes(input)) || (o.order_id && o.order_id.includes(input)));
        }
      }
    } catch(e) {}

    // 2. Fetch from API with safety fallback
    try {
      const res = await fetch(`/api/orders?shop=yesfancy`);
      if (res.ok) {
        const data = await res.json();
        if (data.orders && Array.isArray(data.orders)) {
          const remoteFound = data.orders.filter(o => (o.phone && o.phone.includes(input)) || (o.order_id && o.order_id.includes(input)) || (o.customer_name && o.customer_name.toLowerCase().includes(input.toLowerCase())));
          remoteFound.forEach(ro => {
            if (!foundOrders.some(fo => fo.order_id === ro.order_id || fo.id === ro.id)) {
              foundOrders.push(ro);
            }
          });
        }
      }
    } catch(e) {}

    if (foundOrders.length === 0) {
      statusBox.innerHTML = `
        <div class="text-center py-6 border border-dashed border-rose-300 rounded-lg space-y-2 bg-rose-50/50">
          <div class="text-2xl">⚠️</div>
          <div class="font-bold text-slate-800 text-xs">No Active Orders Found</div>
          <div class="text-[11px] text-slate-500">No order matches phone or Order ID "${input}".</div>
        </div>
      `;
    } else {
      statusBox.innerHTML = foundOrders.map(order => `
        <div class="border border-slate-200 rounded-lg p-3 space-y-2 bg-slate-50 mb-3 text-left">
          <div class="flex justify-between items-center border-b border-slate-200 pb-2">
            <div>
              <span class="font-extrabold text-slate-900 text-xs">Order #${order.order_id || order.id || 'CONFIRMED'}</span>
              <span class="text-[11px] text-slate-500 block">${order.customer_name || 'Customer'}</span>
            </div>
            <span class="text-[10px] font-bold text-emerald-700 bg-emerald-100 px-2 py-0.5 rounded">${order.status || 'Processing'}</span>
          </div>
          <div class="text-[11px] text-slate-600 space-y-0.5">
            ${Array.isArray(order.items) ? order.items.map(i => `<div>${typeof i === 'object' ? `${i.name} (Qty: ${i.qty})` : i}</div>`).join('') : `<div>${order.items || 'Items placed via WhatsApp'}</div>`}
          </div>
          <div class="flex justify-between items-center pt-2 border-t border-slate-200 text-xs font-bold">
            <span>Total: ₹ ${order.total || order.total_amount || 0}</span>
            <span class="text-[10px] text-slate-400 font-normal">${order.timestamp || order.created_at || ''}</span>
          </div>
        </div>
      `).join('');
    }
  };
</script>

---
/**
 * src/components/TagShowcaseRow.astro
 * 
 * Generic Reusable Tag Showcase Component:
 * - Single-row horizontal scroll track across ALL screen sizes.
 * - Displays initialCount (4) items visible with right-scroll capability up to maxScrollCount (10).
 * - Includes Left/Right scroll navigation arrows for desktop users.
 * - Includes a 'SHOW MORE ➔' card at the end of the scroll track.
 */

import ProductCard from './ProductCard.astro';

export interface Props {
  tagId: string;
  title: string;
  products: any[];
  shopSlug: string;
  initialCount?: number;
  maxScrollCount?: number;
}

const { tagId, title, products = [], shopSlug, initialCount = 4, maxScrollCount = 10 } = Astro.props;

// Filter matching products by tag ID or category ID
const matchingProducts = products.filter((p: any) => 
  tagId === 'all' ||
  p.category_id === tagId || 
  (Array.isArray(p.tags) && p.tags.includes(tagId))
);

const displayProducts = matchingProducts.slice(0, maxScrollCount);
const cleanTitle = (title || '').replace(/^[^\w\s]+\s*/, '');
const containerId = `tag-row-${tagId.replace(/[^a-z0-9]/gi, '-')}`;
---

{matchingProducts.length > 0 && (
  <section class="max-w-7xl mx-auto px-4 sm:px-6 space-y-4 pt-6">
    <!-- Header with Title, Arrow Buttons, and SHOW MORE link -->
    <div class="flex items-center justify-between border-b border-slate-200 pb-3">
      <h2 class="text-xl sm:text-2xl font-sans font-extrabold text-slate-900 uppercase tracking-wider">
        {cleanTitle}
      </h2>

      <div class="flex items-center space-x-4">
        <!-- Desktop Scroll Arrow Buttons -->
        <div class="hidden sm:flex items-center space-x-2">
          <button 
            onclick={`document.getElementById('${containerId}').scrollBy({ left: -320, behavior: 'smooth' })`}
            class="p-2 border border-slate-300 rounded-full hover:bg-slate-900 hover:text-white hover:border-slate-900 transition-all text-slate-700 cursor-pointer bg-white shadow-xs"
            title="Scroll Left"
          >
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M15 19l-7-7 7-7"/></svg>
          </button>
          <button 
            onclick={`document.getElementById('${containerId}').scrollBy({ left: 320, behavior: 'smooth' })`}
            class="p-2 border border-slate-300 rounded-full hover:bg-slate-900 hover:text-white hover:border-slate-900 transition-all text-slate-700 cursor-pointer bg-white shadow-xs"
            title="Scroll Right"
          >
            <svg class="w-4 h-4" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2.5" d="M9 5l7 7-7 7"/></svg>
          </button>
        </div>

        <a href={`/catalog?shop=${shopSlug}&tag=${tagId}`} class="text-xs font-bold text-slate-900 uppercase tracking-wider hover:underline no-underline">
          SHOW MORE ➔
        </a>
      </div>
    </div>

    <!-- Strictly Single-Row Horizontal Scroll Track -->
    <div 
      id={containerId} 
      class="flex space-x-4 sm:space-x-6 overflow-x-auto py-2 scrollbar-none scroll-smooth"
    >
      {displayProducts.map((p: any) => (
        <div class="w-64 sm:w-72 shrink-0">
          <ProductCard product={p} shopSlug={shopSlug} />
        </div>
      ))}

      {matchingProducts.length > initialCount && (
        <a href={`/catalog?shop=${shopSlug}&tag=${tagId}`} class="w-56 sm:w-64 shrink-0 border-2 border-dashed border-slate-300 rounded-xl flex flex-col items-center justify-center p-6 text-center hover:border-slate-900 hover:bg-slate-50 transition-all no-underline group bg-white">
          <span class="text-3xl mb-3 group-hover:scale-110 transition-transform">🛍️</span>
          <span class="font-serif-title font-extrabold text-xs text-slate-900 uppercase tracking-wider">
            Explore All {matchingProducts.length} Items
          </span>
          <span class="text-[11px] font-bold text-rose-600 mt-2 uppercase tracking-wide">
            SHOW MORE ➔
          </span>
        </a>
      )}
    </div>
  </section>
)}

---
export const prerender = false;

import '@styles/global.css';
import { getAllShopsConfigAsync } from '@lib/getShopConfig';

// Prevent serving stale cache
Astro.response.headers.set('Cache-Control', 'no-cache, no-store, must-revalidate, max-age=0');
Astro.response.headers.set('Pragma', 'no-cache');
Astro.response.headers.set('Expires', '0');

// Fetch all registered shops on Oorumart
const allShops = await getAllShopsConfigAsync();
---

<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>Oorumart | Hyperlocal E-Commerce Marketplace Hub</title>
  
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
</head>
<body class="bg-slate-950 text-white antialiased min-h-screen flex flex-col justify-between select-none">

  <!-- Marketplace Header Nav -->
  <header class="border-b border-slate-800/80 px-6 py-4 bg-slate-950/80 backdrop-blur-md sticky top-0 z-50">
    <div class="max-w-7xl mx-auto flex items-center justify-between">
      <div class="flex items-center space-x-3">
        <span class="text-2xl">🏪</span>
        <span class="font-extrabold text-xl tracking-wider text-white font-serif-title uppercase">Oorumart</span>
      </div>
      <div class="text-xs font-mono text-slate-400 bg-slate-900 border border-slate-800 px-3 py-1.5 rounded-full">
        Hyperlocal Merchant Directory
      </div>
    </div>
  </header>

  <!-- Marketplace Hero & Directory -->
  <main class="max-w-6xl mx-auto w-full px-6 py-12 sm:py-16 space-y-12 my-auto text-center">
    <div class="space-y-4">
      <span class="bg-rose-500/10 text-rose-400 font-mono text-xs px-4 py-1.5 rounded-full border border-rose-500/20 uppercase tracking-widest inline-block">
        🌐 Hyperlocal E-Commerce Marketplace
      </span>
      <h1 class="text-4xl sm:text-6xl font-extrabold tracking-tight font-serif-title text-white">
        Discover Local Neighborhood Stores
      </h1>
      <p class="text-slate-400 text-sm sm:text-base max-w-2xl mx-auto leading-relaxed">
        Direct express commerce connecting customers to verified local merchants with instant doorstep pickup and COD checkout.
      </p>
    </div>

    <!-- Registered Merchant Cards Grid -->
    <div class="grid grid-cols-1 sm:grid-cols-2 md:grid-cols-3 gap-6 pt-6 text-left">
      {allShops.map((s: any) => {
        const storeUrl = s.slug === 'yesfancy' ? 'https://yesfancy.pages.dev' : `https://${s.slug}.pages.dev`;
        return (
          <a 
            href={storeUrl} 
            target="_blank" 
            rel="noopener noreferrer"
            class="group bg-slate-900 border border-slate-800 hover:border-rose-500/50 p-6 rounded-2xl transition-all duration-300 hover:-translate-y-1 shadow-lg no-underline block relative overflow-hidden"
          >
            <div class="flex items-center justify-between mb-4">
              <span class="text-3xl">🏬</span>
              <span class="text-[10px] font-extrabold uppercase px-2.5 py-1 bg-rose-500/10 text-rose-400 border border-rose-500/20 rounded-full">
                {s.category || 'Local Store'}
              </span>
            </div>
            
            <h2 class="text-xl font-bold text-white group-hover:text-rose-400 transition-colors line-clamp-1">
              {s.name}
            </h2>
            
            <p class="text-xs text-slate-400 mt-2 line-clamp-2 leading-relaxed">
              {s.announcement_text || 'Shop authentic local catalog products express online.'}
            </p>
            
            <div class="mt-6 pt-4 border-t border-slate-800/80 text-xs font-bold text-rose-400 flex items-center justify-between group-hover:text-rose-300">
              <span>Visit Storefront</span>
              <span class="group-hover:translate-x-1 transition-transform">➔</span>
            </div>
          </a>
        );
      })}
    </div>
  </main>

  <!-- Footer -->
  <footer class="text-center text-xs text-slate-600 py-8 border-t border-slate-900">
    © 2026 Oorumart Hyperlocal E-Commerce Network. All rights reserved.
  </footer>

</body>
</html>
